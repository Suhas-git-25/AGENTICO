{
  "name": "backend",
  "version": "1.0.0",
  "description": "ReachInbox Email Scheduler - Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "worker": "ts-node-dev --respawn src/workers/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/workers/index.js",
    "start:all": "node dist/workers/index.js & node dist/index.js",
    "test:schedule": "ts-node-dev src/scripts/testSchedule.ts",
    "test:recovery": "ts-node-dev src/scripts/testWorkerRecovery.ts",
    "test:elastic": "ts-node-dev src/scripts/testElasticSearch.ts",
    "test:auth": "ts-node-dev src/scripts/testAuthFlow.ts",
    "test:slack": "ts-node-dev src/scripts/testSlackNotification.ts",
    "loadtest": "ts-node-dev src/scripts/loadTest.ts",
    "db:seed": "prisma db seed",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "ts-node-dev prisma/seed.ts"
  },
  "dependencies": {
    "@bull-board/api": "^9.8.0",
    "@bull-board/express": "^9.8.0",
    "@elastic/elasticsearch": "^9.5.1",
    "@prisma/client": "^5.22.0",
    "bullmq": "^6.3.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-session": "^1.19.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/node": "^20.17.6",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "prisma": "^5.22.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
